// A static-only Worker: no script, Cloudflare serves Astro's dist/ as assets.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uzzy-site",
  "compatibility_date": "2026-09-27",
  // Keep the workers.dev URL and per-branch preview URLs on across deploys.
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
