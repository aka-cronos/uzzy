---
// The 07c logo next to the "Uzzy" wordmark: title case, system font at ~650,
// tracking about -0.05em (issue #116). Same size in the header and the footer.
import Mark from "./Mark.astro";
import { LOGO } from "@/lib/marks";
const { class: cls = "" } = Astro.props;
---
<a href="/" class={`flex min-h-11 items-center gap-1.5 rounded text-xl font-[650] tracking-[-0.05em] ${cls}`}><Mark d={LOGO} class="size-[22px]" />Uzzy</a>
