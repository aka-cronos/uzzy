---
// PROTOTYPE — Variant A "Classic product page": light, centered, the real
// screenshot as the hero, then features / providers / privacy / CTA.
import * as c from "./content";
import GaugeIcon from "./GaugeIcon.astro";
---
<div class="min-h-screen bg-white text-zinc-900">
  <header class="mx-auto flex max-w-5xl items-center justify-between px-6 py-5">
    <a href="#" class="flex items-center gap-2 font-semibold"><GaugeIcon /> Uzzy</a>
    <nav class="flex items-center gap-6 text-sm text-zinc-600">
      <a href="#features" class="hover:text-zinc-900">Features</a>
      <a href="#privacy" class="hover:text-zinc-900">Privacy</a>
      <a href={c.REPO_URL} class="hover:text-zinc-900">GitHub</a>
    </nav>
  </header>

  <section class="mx-auto max-w-3xl px-6 pt-16 text-center">
    <h1 class="text-5xl font-semibold tracking-tight sm:text-6xl">{c.tagline}</h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg text-zinc-600">{c.lede}</p>
    <div class="mt-9 flex flex-col items-center gap-3">
      <a href={c.DOWNLOAD_URL} class="rounded-lg bg-zinc-900 px-6 py-3 font-medium text-white hover:bg-zinc-700"> Download for Mac</a>
      <p class="text-sm text-zinc-500">Free · Version {c.VERSION} · {c.REQUIREMENTS}</p>
    </div>
  </section>

  <section class="mx-auto mt-16 flex max-w-4xl justify-center px-6">
    <div class="rounded-3xl bg-gradient-to-b from-zinc-100 to-white p-10">
      <img src="/panel.png" width="400" alt="The Uzzy panel with cards for Claude, Codex and Cursor" class="drop-shadow-2xl" />
      <p class="mt-3 text-center text-xs text-zinc-400">[prototype: Spanish screenshot, replace with the English UI]</p>
    </div>
  </section>

  <section id="features" class="mx-auto max-w-5xl px-6 py-24">
    <p class="mx-auto max-w-2xl text-center text-zinc-600">{c.why}</p>
    <div class="mt-14 grid gap-6 sm:grid-cols-2">
      {c.features.map((f) => (
        <div class="rounded-2xl border border-zinc-200 p-6">
          <h3 class="font-semibold">{f.title}</h3>
          <p class="mt-2 text-zinc-600">{f.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-zinc-50 py-24">
    <div class="mx-auto max-w-5xl px-6">
      <h2 class="text-center text-3xl font-semibold tracking-tight">Works with the tools you already use</h2>
      <div class="mt-12 grid gap-6 sm:grid-cols-3">
        {c.providers.map((p) => (
          <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-zinc-200">
            <h3 class="text-xl font-semibold">{p.name}</h3>
            <p class="mt-1 text-sm text-zinc-500">Reuses your {p.session} session</p>
            <p class="mt-4 text-sm text-zinc-700">{p.quotas}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="privacy" class="mx-auto max-w-3xl px-6 py-24">
    <h2 class="text-center text-3xl font-semibold tracking-tight">Private by design</h2>
    <ul class="mt-10 space-y-4">
      {c.privacy.map((p) => <li class="flex gap-3 text-zinc-700"><span class="text-emerald-600">✓</span>{p}</li>)}
    </ul>
  </section>

  <section class="mx-auto max-w-5xl px-6 pb-24">
    <div class="rounded-3xl bg-zinc-900 px-8 py-16 text-center text-white">
      <h2 class="text-3xl font-semibold tracking-tight">Stop opening three dashboards.</h2>
      <a href={c.DOWNLOAD_URL} class="mt-8 inline-block rounded-lg bg-white px-6 py-3 font-medium text-zinc-900 hover:bg-zinc-200"> Download for Mac</a>
      <p class="mt-3 text-sm text-zinc-400">{c.REQUIREMENTS} · Open source, MIT</p>
    </div>
  </section>

  <footer class="border-t border-zinc-200">
    <div class="mx-auto flex max-w-5xl flex-col gap-4 px-6 py-8 text-sm text-zinc-500 sm:flex-row sm:justify-between">
      <span>© 2026 Uzzy · <a href={c.REPO_URL} class="underline">GitHub</a> · <a href={`${c.REPO_URL}/blob/main/LICENSE`} class="underline">MIT License</a></span>
      <span class="max-w-md text-xs">{c.disclaimer}</span>
    </div>
  </footer>
</div>
