---
// PROTOTYPE — Variant B "Desktop scene": dark, the hero IS a macOS desktop with
// a menu bar and the panel (rebuilt in HTML, in English) dropping from the icon.
// Features read as a scroll story; privacy as a network log.
import * as c from "./content";
import GaugeIcon from "./GaugeIcon.astro";
import HtmlPanel from "./HtmlPanel.astro";
---
<div class="min-h-screen bg-black text-white">
  <section class="relative min-h-screen overflow-hidden bg-[radial-gradient(ellipse_at_top_right,#2b3a67_0%,#0b0b12_55%,#000_100%)]">
    <!-- fake macOS menu bar -->
    <div class="flex h-7 items-center justify-between bg-white/10 px-4 text-[13px] backdrop-blur">
      <span class="flex gap-5"><span></span><span class="font-semibold">Uzzy</span></span>
      <span class="flex items-center gap-4 text-white/80">
        <span class="rounded bg-white/25 px-1.5 py-0.5 text-white"><GaugeIcon class="size-4" /></span>
        <span>Wi‑Fi</span><span>Sat 26 Sep 4:47 PM</span>
      </span>
    </div>
    <div class="mx-auto grid max-w-6xl items-start gap-12 px-6 pt-20 lg:grid-cols-[1fr_auto]">
      <div class="pt-10">
        <p class="font-mono text-sm text-sky-300">For people with more than one AI subscription</p>
        <h1 class="mt-4 text-6xl font-semibold leading-[1.02] tracking-tight">Know your limits<br />before you hit them.</h1>
        <p class="mt-6 max-w-lg text-lg text-white/70">{c.lede}</p>
        <div class="mt-9 flex items-center gap-5">
          <a href={c.DOWNLOAD_URL} class="rounded-full bg-white px-6 py-3 font-medium text-black hover:bg-white/85">Download Uzzy {c.VERSION}</a>
          <a href={c.REPO_URL} class="text-white/70 hover:text-white">View on GitHub →</a>
        </div>
        <p class="mt-4 text-sm text-white/45">{c.REQUIREMENTS} · Free and open source</p>
      </div>
      <!-- panel hangs right under the icon position -->
      <HtmlPanel class="lg:-mt-16 lg:mr-24" />
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 py-32">
    {c.features.map((f, i) => (
      <div class="grid items-center gap-10 border-t border-white/10 py-16 md:grid-cols-2">
        <span class={`font-mono text-8xl font-semibold text-white/10 ${i % 2 ? "md:order-2 md:text-right" : ""}`}>0{i + 1}</span>
        <div>
          <h3 class="text-3xl font-semibold tracking-tight">{f.title}</h3>
          <p class="mt-4 text-lg text-white/65">{f.body}</p>
        </div>
      </div>
    ))}
  </section>

  <section class="border-y border-white/10 py-24">
    <div class="mx-auto max-w-5xl px-6">
      <h2 class="text-3xl font-semibold tracking-tight">Nothing to sign in to.</h2>
      <p class="mt-3 max-w-2xl text-white/60">Uzzy reuses the sessions your tools already keep on your Mac.</p>
      <div class="mt-12 divide-y divide-white/10">
        {c.providers.map((p) => (
          <div class="grid gap-2 py-6 md:grid-cols-[180px_1fr_1.4fr]">
            <span class="text-2xl font-semibold">{p.name}</span>
            <span class="text-white/55">via {p.session}</span>
            <span class="text-white/80">{p.quotas}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto grid max-w-5xl gap-12 px-6 py-24 md:grid-cols-2">
    <div>
      <h2 class="text-3xl font-semibold tracking-tight">This is every place Uzzy connects to.</h2>
      <ul class="mt-8 space-y-3 text-white/65">{c.privacy.map((p) => <li>{p}</li>)}</ul>
    </div>
    <div class="rounded-xl border border-white/10 bg-white/[0.03] p-5 font-mono text-sm">
      <div class="text-white/40">$ uzzy --network-log</div>
      {c.hosts.map((h) => <div class="mt-2"><span class="text-emerald-400">GET</span> https://{h}/…</div>)}
      <div class="mt-4 text-white/40"># telemetry: none</div>
      <div class="text-white/40"># own server: none</div>
      <div class="text-white/40"># written to disk: nothing</div>
    </div>
  </section>

  <footer class="border-t border-white/10 px-6 py-10 text-center text-sm text-white/40">
    <a href={c.DOWNLOAD_URL} class="text-white hover:underline">Download</a> ·
    <a href={c.REPO_URL} class="hover:text-white">GitHub</a> ·
    <a href={`${c.REPO_URL}/blob/main/LICENSE`} class="hover:text-white">MIT License</a>
    <p class="mx-auto mt-4 max-w-2xl text-xs">{c.disclaimer}</p>
  </footer>
</div>
