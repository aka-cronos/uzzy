---
import "@/styles/global.css";
import { hero } from "@/content";

interface Props {
  title?: string;
}
const { title = "Uzzy — your AI coding quotas in the menu bar" } = Astro.props;
const ogImage = new URL("/og.png", Astro.site).href;
---
<html lang="en" class="bg-slate-50">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={hero.subtitle} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- og.png is exported from Figma (file Uzzy, frame "og:image — uzzy.app (1200×630)") -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:title" content="Uzzy — your AI subscription quotas, in your menu bar" />
    <meta property="og:description" content={hero.subtitle} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Uzzy: the panel hanging from the menu bar, with the quotas for Claude, Codex and Cursor." />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="bg-slate-50 font-[system-ui,Inter,sans-serif] text-slate-900 antialiased">
    <slot />
  </body>
</html>
