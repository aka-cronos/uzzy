---
// PROTOTYPE — throwaway. Social preview (og:image) candidates for #116, each a
// 1200×630 frame; ?frame=a|b shows one frame alone at the page origin for capture.
import "../../styles/global.css";
import Mark from "../../components/prototype/Mark.astro";
import { LOGO } from "../../components/prototype/marks";
const headline = "Your AI subscription quotas, in your menu bar.";
const sub = "Claude, Codex and Cursor · macOS 27 · Free and open source";
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>og:image candidates</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="bg-slate-300 font-[system-ui,Inter,sans-serif] antialiased">
    <div class="flex flex-col items-start gap-10 p-10 [&.solo]:gap-0 [&.solo]:p-0" id="frames">
      <!-- A: light page, the app icon as the hook, page headline -->
      <section data-frame="a" class="relative flex h-[630px] w-[1200px] shrink-0 items-center gap-14 overflow-hidden bg-slate-50 px-24 text-slate-900">
        <img src="/brand/app-icon-1024.png" alt="" width="300" height="300" class="-ml-6 size-[300px]" />
        <div class="flex flex-col gap-6">
          <p class="flex items-center gap-2.5 text-[40px] font-[650] tracking-[-0.05em]"><Mark d={LOGO} class="size-[42px]" />Uzzy</p>
          <p class="text-[56px] leading-[1.08] font-semibold tracking-tight text-balance">{headline}</p>
          <p class="text-2xl text-slate-600">{sub}</p>
        </div>
      </section>
      <!-- B: the CTA banner's tinted wallpaper, the logo in light -->
      <section data-frame="b" class="relative flex h-[630px] w-[1200px] shrink-0 flex-col justify-center gap-7 overflow-hidden bg-slate-950 px-24 text-slate-50">
        <img src="/cover/bg.jpg" alt="" class="absolute inset-0 size-full object-cover opacity-40" />
        <p class="relative flex items-center gap-3 text-[48px] font-[650] tracking-[-0.05em]"><Mark d={LOGO} class="size-[50px]" />Uzzy</p>
        <p class="relative max-w-[900px] text-[64px] leading-[1.06] font-semibold tracking-tight text-balance">{headline}</p>
        <p class="relative text-2xl text-slate-300">{sub}</p>
      </section>
    </div>
    <script>
      const frame = new URL(location.href).searchParams.get("frame");
      if (frame) {
        document.getElementById("frames")!.classList.add("solo");
        document.querySelectorAll<HTMLElement>("[data-frame]").forEach((el) => (el.hidden = el.dataset.frame !== frame));
      }
    </script>
  </body>
</html>
