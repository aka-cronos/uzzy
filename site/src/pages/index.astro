---
// The uzzy.app landing: variant F from issue #105 with the identity from #116
// (variant I): the 07c lockup, the 06b cards in the menu bar and the app icon
// in the CTA banner.
import Layout from "@/layouts/Layout.astro";
import DesktopCard from "@/components/DesktopCard.astro";
import Lockup from "@/components/Lockup.astro";
import { DownloadButton } from "@/components/DownloadButton";
import * as c from "@/content";

const logos = { Claude: "/cover/claude.svg", Codex: "/cover/codex.svg", Cursor: "/cover/cursor.svg" };
const logo = (name: string) => logos[name as keyof typeof logos];
// the Codex and Cursor logos are white; invert them on light surfaces
const onLight = (name: string) => (name === "Claude" ? "" : "invert");
// hero + header fill one viewport, capped at a 14" MacBook Pro viewport
const heroHeight = "clamp(620px, calc(100vh - 72px), 788px)";
const focus = "focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-slate-900";
const nav = [["Features", "#features"], ["Providers", "#providers"], ["Privacy", "#privacy"]];
// Lucide paths
const icons = [
  '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/>',
  '<path d="M3 3v18h18"/><path d="M7 16h3M7 12h7M7 8h11"/>',
  '<path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/>',
  '<path d="M12 9v4M12 17h.01"/><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/>',
];
const check = '<path d="M20 6 9 17l-5-5"/>';
---
<Layout>
  <header class="mx-auto flex h-[72px] max-w-[1280px] items-center justify-between px-6 sm:px-10 lg:px-20">
    <Lockup class={focus} />
    <nav class="flex items-center gap-1 text-sm font-medium text-slate-600" aria-label="Main">
      {nav.map(([label, href]) => (
        <a href={href} class={`hidden min-h-11 items-center rounded-md px-3 transition-colors duration-200 hover:text-slate-900 sm:inline-flex ${focus}`}>{label}</a>
      ))}
      <DownloadButton label="Download" icon={false} size="sm" className="ml-3" />
    </nav>
  </header>

  <div class="mx-auto grid max-w-[1280px] gap-16 px-6 sm:px-10 lg:grid-cols-[1fr_560px] lg:px-20 lg:pb-16">
    <main class="min-w-0">
      <section class="flex flex-col justify-center gap-9 py-16 lg:h-(--hero) lg:py-0" style={`--hero:${heroHeight}`}>
        <div class="flex flex-col gap-4">
          <h1 class="text-4xl leading-[1.1] font-semibold tracking-tight text-balance sm:text-5xl">{c.hero.title}</h1>
          <p class="max-w-xl text-lg leading-relaxed text-pretty text-slate-600">{c.hero.subtitle}</p>
        </div>
        <ul class="flex flex-wrap gap-3" aria-label="Supported providers">
          {c.providers.map((p) => (
            <li class="flex items-center gap-2 rounded-full border border-slate-300 bg-slate-100 px-3.5 py-1 text-sm font-medium text-slate-700">
              <img src={logo(p.name)} alt="" width="16" height={p.name === "Cursor" ? 18 : 16} class={onLight(p.name)} />{p.name}
            </li>
          ))}
        </ul>
        <div class="flex flex-col gap-3">
          <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
            <DownloadButton />
            <a href={c.REPO_URL} class={`inline-flex min-h-11 items-center rounded font-medium text-slate-600 underline-offset-4 transition-colors duration-200 hover:text-slate-900 hover:underline ${focus}`}>View on GitHub</a>
          </div>
          <p class="text-sm text-slate-600">Free and open source · Version {c.VERSION} · {c.REQUIREMENTS}</p>
        </div>
      </section>

      <!-- small screens: the desktop card sits under the hero, scaled to fit -->
      <div class="flex justify-center pb-16 lg:hidden">
        <DesktopCard class="[zoom:0.6] sm:[zoom:0.85]" />
      </div>

      <section id="features" class="scroll-mt-6 border-t border-slate-200 py-20 lg:py-24">
        <p class="text-sm font-semibold tracking-wide text-slate-500 uppercase">Why Uzzy</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-balance">One panel instead of three dashboards.</h2>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-pretty text-slate-600">{c.why}</p>
        <div class="mt-12 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-1">
          {c.features.map((f, i) => (
            <div class="flex gap-5">
              <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-slate-100 text-slate-700 ring-1 ring-slate-200">
                <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[i]} />
              </span>
              <div>
                <h3 class="text-lg font-semibold">{f.title}</h3>
                <p class="mt-1.5 leading-relaxed text-slate-600">{f.body}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="providers" class="scroll-mt-6 border-t border-slate-200 py-20 lg:py-24">
        <p class="text-sm font-semibold tracking-wide text-slate-500 uppercase">Providers</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-balance">Nothing to sign in to.</h2>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-600">Uzzy reuses the sessions your tools already keep on your Mac.</p>
        <ul class="mt-10 divide-y divide-slate-200 rounded-2xl bg-slate-100 ring-1 ring-slate-200">
          {c.providers.map((p) => (
            <li class="flex gap-5 p-6">
              <span class="grid size-11 shrink-0 place-items-center rounded-full bg-slate-900">
                <img src={logo(p.name)} alt="" width="20" height={p.name === "Cursor" ? 22 : 20} />
              </span>
              <div>
                <h3 class="text-lg font-semibold">{p.name}</h3>
                <p class="text-sm text-slate-600">Reuses your {p.session} session</p>
                <p class="mt-2 text-slate-700">{p.quotas}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <section id="privacy" class="scroll-mt-6 border-t border-slate-200 py-20 lg:py-24">
        <p class="text-sm font-semibold tracking-wide text-slate-500 uppercase">Privacy</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-balance">Your credentials stay where they are.</h2>
        <ul class="mt-10 space-y-5">
          {c.privacy.map((p) => (
            <li class="flex gap-4 text-lg leading-relaxed text-slate-700">
              <span class="mt-1 grid size-6 shrink-0 place-items-center rounded-full bg-slate-200 text-slate-700">
                <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={check} />
              </span>
              {p}
            </li>
          ))}
        </ul>
        <div class="mt-8 flex flex-wrap gap-2" aria-label="The only hosts Uzzy connects to">
          {c.hosts.map((h) => <code class="rounded-md bg-slate-100 px-2.5 py-1 font-mono text-sm text-slate-700 ring-1 ring-slate-200">{h}</code>)}
        </div>
      </section>
    </main>

    <!-- large screens: vertically centred in the hero, then sticky while scrolling; the grid's bottom padding stops it 64px before the CTA banner -->
    <aside class="hidden lg:block" style={`padding-top:max(0px, calc((${heroHeight} - 730px) / 2))`}>
      <DesktopCard class="sticky top-6" />
    </aside>
  </div>

  <section class="mx-auto max-w-[1280px] px-6 pb-20 sm:px-10 lg:px-20 lg:pb-24">
    <div class="relative overflow-hidden rounded-2xl bg-slate-950 px-8 py-16 text-center text-slate-50">
      <!-- same tinted wallpaper as the desktop card -->
      <img src="/cover/bg.jpg" alt="" class="absolute inset-0 size-full object-cover" loading="lazy" />
      <div class="relative">
        <!-- the macOS rendering of AppIcon.icon; the PNG keeps macOS's transparent margin -->
        <img src="/brand/app-icon-512.png" alt="" width="104" height="104" class="mx-auto mb-5 size-[104px]" loading="lazy" />
        <h2 class="text-3xl font-semibold tracking-tight text-balance">Stop opening three dashboards.</h2>
        <p class="mt-3 text-slate-300">Every quota, one click away in your menu bar.</p>
        <DownloadButton variant="inverse" className="mt-8" />
        <p class="mt-4 text-sm text-slate-300">{c.REQUIREMENTS} · Open source, MIT</p>
      </div>
    </div>
  </section>

  <footer class="border-t border-slate-200">
    <div class="mx-auto max-w-[1280px] px-6 sm:px-10 lg:px-20">
      <!-- brand and links on one line; the legal small print gets its own full-width band -->
      <div class="flex flex-col gap-4 py-8 sm:flex-row sm:items-center sm:justify-between">
        <Lockup class={`self-start sm:self-auto ${focus}`} />
        <nav class="flex gap-6 text-sm font-medium text-slate-600" aria-label="Footer">
          <a href={c.REPO_URL} class={`inline-flex min-h-11 items-center rounded transition-colors duration-200 hover:text-slate-900 ${focus}`}>GitHub</a>
          <a href={`${c.REPO_URL}/releases`} class={`inline-flex min-h-11 items-center rounded transition-colors duration-200 hover:text-slate-900 ${focus}`}>Releases</a>
          <a href={`${c.REPO_URL}/blob/main/LICENSE`} class={`inline-flex min-h-11 items-center rounded transition-colors duration-200 hover:text-slate-900 ${focus}`}>MIT License</a>
        </nav>
      </div>
      <div class="space-y-2 border-t border-slate-200 py-6 text-xs leading-relaxed text-slate-600">
        <p>{c.disclaimer}</p>
        <!-- Unsplash License: credit not required, but appreciated -->
        <p>© 2026 Uzzy · Background photo by <a href="https://unsplash.com/@norbertkowalczyk?utm_source=uzzy&utm_medium=referral" class={`underline underline-offset-2 hover:text-slate-900 ${focus}`}>Norbert Kowalczyk</a> on <a href="https://unsplash.com/photos/dark-curved-lines-create-a-mesmerizing-pattern-HuvxHRcOY6E?utm_source=uzzy&utm_medium=referral" class={`underline underline-offset-2 hover:text-slate-900 ${focus}`}>Unsplash</a>.</p>
      </div>
    </div>
  </footer>
</Layout>
