            "state" : "translated",
            "value" : "Muestra cuánto has usado de cada límite o cuánto te queda hasta el reinicio."
          }
        }
      }
    },
    "Sign in to %@ and click Refresh." : {
      "comment" : "%@ is the official app.",
      "localizations" : {
