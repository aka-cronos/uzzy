{
  "sourceLanguage" : "en",
  "strings" : {
    "Credit balance": {
      "comment": "Positive general prepaid balance, separate from monthly spending.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldo de créditos"
          }
        }
      }
    },
    "Cloud session credits": {
      "comment": "Restricted Claude cloud-session grant, separate from general prepaid balance.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Créditos para sesiones en la nube"
          }
        }
      }
    },
    "%@ credits left": {
      "comment": "Exact Codex credit quantity, not money.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ créditos restantes"
          }
        }
      }
    },
    "%@ of %@ left": {
      "comment": "Remaining cloud-session money and original allowance.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ de %2$@ restantes"
          }
        }
      }
    },
    "Expires %@, %@": {
      "comment": "Exact local expiry date and time of cloud-session credit.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vence %1$@, %2$@"
          }
        }
      }
    },
    "%@ ago" : {
      "comment" : "How long ago the card figures were read, e.g. \"2 min ago\". %@ is the time, e.g. \"2 min\". It always follows other words.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "hace %@"
          }
        }
      }
    },
    "%@ asked to wait. It will be checked again from %@." : {
      "comment" : "The provider, then a moment, e.g. \"today, 14:42\".",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ pidió esperar. Se volverá a consultar a partir de: %2$@."
          }
        }
      }
    },
    "%@ asked to wait. It will be checked again shortly." : {
      "comment" : "%@ is the provider.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pidió esperar. Se volverá a consultar en breve."
          }
        }
      }
    },
    "%@ can read the key Cursor encrypts its session with." : {
      "comment" : "Description of the Keychain access row. %@ is the app's name.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ puede leer la clave con la que Cursor cifra su sesión."
          }
        }
      }
    },
    "%@ didn't accept the saved session. %@ updates on its own once it's renewed, or click Refresh to check it now." : {
      "comment" : "The first %@ is the provider, the second the app's name.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ no aceptó la sesión guardada. %2$@ se actualiza solo cuando se renueve, o pulsa Actualizar para comprobarla ahora."
          }
        }
      }
    },
    "%@ didn't accept the saved session. Click Refresh to check it again." : {
      "comment" : "%@ is the provider.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no aceptó la sesión guardada. Pulsa Actualizar para volver a comprobarla."
          }
        }
      }
    },
    "%@ didn't respond in time. Click Refresh to try again." : {
      "comment" : "%@ is the provider.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no respondió a tiempo. Pulsa Actualizar para reintentar."
          }
        }
      }
    },
    "%@ no longer reads Cursor's key. If you chose Always Allow, macOS still lets it, and only you can remove that: open Keychain Access, search for \"Cursor Safe Storage\" (account Cursor), open it, and in Access Control remove %@, then Save Changes." : {
      "comment" : "Steps to remove Uzzy from the access control of Cursor's keychain item. Use the names macOS shows in Keychain Access in each language. %@ is the app's name, twice.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ya no lee la clave de Cursor. Si elegiste Permitir siempre, macOS se lo sigue permitiendo, y solo tú puedes quitarlo: abre Acceso a Llaveros, busca «Cursor Safe Storage» (cuenta Cursor), ábrelo y, en Control de acceso, quita %2$@ y pulsa Guardar cambios."
          }
        }
      }
    },
    "%@ of %@ this month" : {
      "comment" : "Usage credits spent this month and the monthly spend limit, e.g. \"$53.06 of $40 this month\".",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ de %2$@ este mes"
          }
        }
      }
    },
    "%@ refused the query. It may be an account restriction; check it in %@ and click Refresh." : {
      "comment" : "The provider, then the official app.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ rechazó la consulta. Puede ser una restricción de la cuenta; revísala en %2$@ y pulsa Actualizar."
          }
        }
      }
    },
    "%@ responded in a format %@ doesn't recognize. Its service may have changed." : {
      "comment" : "The provider, then the app name.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ respondió en un formato que %2$@ no reconoce. Puede que haya cambiado su servicio."
          }
        }
      }
    },
    "%@ responded with an error (%lld). Click Refresh to try again." : {
      "comment" : "The provider, then the HTTP status code.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ respondió con un error (%2$lld). Pulsa Actualizar para reintentar."
          }
        }
      }
    },
    "%@ this month" : {
      "comment" : "Usage credits spent this month, without a monthly spend limit.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ este mes"
          }
        }
      }
    },
    "%@ will stop reading the Cursor session until you allow it again on the Cursor card." : {
      "comment" : "Message of the revocation confirmation. %@ is the app's name.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dejará de leer la sesión de Cursor hasta que vuelvas a permitirlo en la tarjeta de Cursor."
          }
        }
      }
    },
    "%@, %@ plan" : {
      "comment" : "A card title as VoiceOver reads it: the provider and its plan, e.g. \"Claude, Max plan\".",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, plan %2$@"
          }
        }
      }
    },
    "%lld d" : {
      "comment" : "Days, in one magnitude: the time left until a reset in the simple countdown, or the time since the last reading.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld d"
          }
        }
      }
    },
    "%lld d %lld h" : {
      "comment" : "Time left until a reset, in days and hours, in the detailed countdown.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld d %2$lld h"
          }
        }
      }
    },
    "%lld days" : {
      "comment" : "The length of a usage limit period.",
