{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ asked to wait. It will be checked again from %@." : {
      "comment" : "The provider, then a moment, e.g. \"today, 14:42\".",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ pidió esperar. Se volverá a consultar a partir de: %2$@."
          }
        }
      }
    },
    "%@ asked to wait. It will be checked again shortly." : {
      "comment" : "%@ is the provider.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pidió esperar. Se volverá a consultar en breve."
          }
        }
      }
    },
    "%@ didn't accept the saved session. Click Refresh to check it again." : {
      "comment" : "%@ is the provider.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no aceptó la sesión guardada. Pulsa Actualizar para volver a comprobarla."
          }
        }
      }
    },
    "%@ didn't respond in time. Click Refresh to try again." : {
      "comment" : "%@ is the provider.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no respondió a tiempo. Pulsa Actualizar para reintentar."
          }
        }
      }
    },
    "%@ of %@ this month" : {
      "comment" : "Usage credits spent this month and the monthly spend limit, e.g. \"$53.06 of $40 this month\".",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ de %2$@ este mes"
          }
        }
      }
    },
    "%@ refused the query. It may be an account restriction; check it in %@ and click Refresh." : {
      "comment" : "The provider, then the official app.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ rechazó la consulta. Puede ser una restricción de la cuenta; revísala en %2$@ y pulsa Actualizar."
          }
        }
      }
    },
    "%@ responded in a format %@ doesn't recognize. Its service may have changed." : {
      "comment" : "The provider, then the app name.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ respondió en un formato que %2$@ no reconoce. Puede que haya cambiado su servicio."
          }
        }
      }
    },
    "%@ responded with an error (%lld). Click Refresh to try again." : {
      "comment" : "The provider, then the HTTP status code.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ respondió con un error (%2$lld). Pulsa Actualizar para reintentar."
          }
        }
      }
    },
    "%@ this month" : {
      "comment" : "Usage credits spent this month, without a monthly spend limit.",
