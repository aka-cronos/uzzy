        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Última lectura: %@"
          }
        }
      }
    },
    "Lets %@ read the key Cursor encrypts its session with. You can revoke it in Settings." : {
      "comment" : "Help tag of the Allow Access button. %@ is the app's name.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que %@ lea la clave con la que Cursor cifra su sesión. Puedes revocarlo en Ajustes."
          }
        }
      }
    },
    "Move %@ Down" : {
      "comment" : "Moves a provider one place down in the card order. %@ is the provider.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bajar %@"
