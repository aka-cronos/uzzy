// Signs the app ad hoc ("Sign to Run Locally"), so anyone can build without
// an Apple Developer team. To sign with your own team, create
// app/Config/Local.xcconfig (ignored by git) with:
//
//   DEVELOPMENT_TEAM = YOUR_TEAM_ID
//   CODE_SIGN_IDENTITY = Apple Development

CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Local.xcconfig"
